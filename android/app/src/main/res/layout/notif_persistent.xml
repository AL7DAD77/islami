<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- ✅ صف علوي يحتوي على الشعار واسم الصلاة -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- ✅ شعار التطبيق (سيتم تحميله من الكود) -->
        <ImageView
            android:id="@+id/notif_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="شعار التطبيق" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 م"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- المؤقت التنازلي -->
    <Chronometer
        android:id="@+id/notif_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4DB6AC"
        android:textSize="26sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <!-- شريط التقدم -->
    <ProgressBar
        android:id="@+id/notif_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:progressTint="#4CAF50"
        android:progressBackgroundTint="#333333"
        android:max="100"
        android:progress="50" />

</LinearLayout>