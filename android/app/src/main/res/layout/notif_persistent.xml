<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#08130F">

    <!-- Watermark خفيف وأنيق -->
    <ImageView
        android:id="@+id/notif_watermark"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:alpha="0.10"
        android:scaleType="fitCenter"
        android:contentDescription="Watermark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:gravity="center_horizontal">

        <!-- الصلاة والوقت -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/notif_logo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="App Icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notif_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصلاة"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notif_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 م"
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- العدّاد -->
        <Chronometer
            android:id="@+id/notif_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5EEAD4"
            android:textSize="30sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <!-- شريط التقدم -->
        <ProgressBar
            android:id="@+id/notif_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="14dp"
            android:progressTint="#34D399"
            android:progressBackgroundTint="#1F2937"
            android:max="100"
            android:progress="50" />
    </LinearLayout>
</FrameLayout>