<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#08130F">

    <!-- خلفية شعار التطبيق داخل الإشعار الدائم -->
    <ImageView
        android:id="@+id/notif_watermark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:scaleType="centerCrop"
        android:contentDescription="Watermark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_horizontal">

        <!-- الشعار في المنتصف -->
        <ImageView
            android:id="@+id/notif_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:contentDescription="App Icon"
            android:layout_marginBottom="4dp" />

        <!-- اسم التطبيق (بخط ذهبي) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إسلامي"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- التاريخ الهجري -->
        <TextView
            android:id="@+id/notif_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="هـ"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <!-- اسم الصلاة والوقت -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/notif_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 م"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- العدّاد -->
        <Chronometer
            android:id="@+id/notif_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5EEAD4"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- شريط التقدم -->
        <ProgressBar
            android:id="@+id/notif_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:progressTint="#34D399"
            android:progressBackgroundTint="#1F2937"
            android:max="100"
            android:progress="50" />
    </LinearLayout>
</FrameLayout>
